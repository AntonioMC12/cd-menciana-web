{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cd-menciana-cms",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  "vars": { "PUBLIC_WEB_ORIGIN": "https://cdmenciana.es", "PUBLIC_WEB_BASE": "/" },
  "routes": [{ "pattern": "cms.cdmenciana.es", "custom_domain": true },
    { "pattern": "cdmenciana.es/tienda/stock*", "zone_name": "cdmenciana.es" }],
  "workers_dev": false,
  "triggers": { "crons": ["0,15,30,45 * * * *"] },
  "d1_databases": [{
    "binding": "DB", "database_name": "cd-menciana",
    "database_id": "60c706e0-bf4f-402e-86ef-0ff3c98f0f19",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "cd-menciana-photos" }]
}
