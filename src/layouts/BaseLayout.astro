---
import { sitePath } from '../lib/paths';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import { site } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; image?: string; ogType?: 'website' | 'article'; publishedAt?: string; structuredData?: Record<string, unknown> | Record<string, unknown>[] }
const { title, description = site.description, noindex = false, image, ogType = 'website', publishedAt, structuredData } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || sitePath('/og.svg?v=escudo-vector-20261005'), Astro.site);
const rasterImage = new URL(image || sitePath('/og.png?v=escudo-central-20261005'), Astro.site);
const imageAlt = image ? pageTitle : 'Club Deportivo Menciana · Apaga y Vámonos F.S. · Escudo del club y lema Más que fútbol sala.';
const jsonLd = structuredData ? JSON.stringify(structuredData).replaceAll('<', '\\u003c') : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0D2E5B" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={sitePath('/images/escudo-oficial.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={sitePath('/sitemap-index.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:type" content="image/svg+xml" /></>}
    <meta property="og:image:alt" content={imageAlt} />
    {!image && <>
      <meta property="og:image" content={rasterImage} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={imageAlt} />
    </>}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={rasterImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>
