---
import type { TeamRoster } from '../data/team-rosters';
interface Props { roster: TeamRoster }
const { roster } = Astro.props;
---
<div class="team-roster team-roster--text">
  <div class="roster-heading"><p class="eyebrow">{roster.school ? 'ESCUELA DEPORTIVA' : 'LAS PERSONAS DEL EQUIPO'}</p><h3>{roster.school ? 'Coordinación y monitores' : 'Plantilla y cuerpo técnico'}</h3></div>
  {(roster.goalkeepers?.length || roster.players?.length) && <div class:list={['roster-groups', { 'roster-groups--single': !roster.goalkeepers?.length }]}>
    {roster.goalkeepers?.length && <section class="roster-group"><h4>Porteros <span>{roster.goalkeepers.length}</span></h4><ul>{roster.goalkeepers.map(name => <li>{name}</li>)}</ul></section>}
    {roster.players?.length && <section class="roster-group"><h4>Jugadores <span>{roster.players.length}</span></h4><ul>{roster.players.map(name => <li>{name}</li>)}</ul></section>}
  </div>}
  <section class="roster-staff"><h4>{roster.school ? 'Equipo de la escuela' : 'Cuerpo técnico'}</h4><ul>{roster.staff.map(member => <li>{member.role && <span>{member.role}</span>}<strong>{member.name}</strong></li>)}</ul></section>
</div>
<style>
  .roster-heading .eyebrow { margin-bottom: 12px; }
  .roster-heading h3 { margin-bottom: 24px; font-size: 1.6rem; }
  .roster-groups { display: grid; grid-template-columns: minmax(200px, .6fr) minmax(0, 1.4fr); gap: 24px; }
  .roster-groups--single { grid-template-columns: 1fr; }
  .roster-group { min-width: 0; padding: 24px; background: white; border: 1px solid var(--line); border-radius: 10px; }
  h4 { margin: 0 0 18px; color: var(--ui-navy); font-size: 1rem; }
  .roster-group h4 { display: flex; align-items: center; gap: 12px; }
  .roster-group h4 span { padding: 2px 8px; border-radius: 4px; color: var(--ui-blue-ink); background: var(--ui-bg); font-size: .7rem; }
  ul { padding: 0; margin: 0; list-style: none; }
  .roster-group ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 24px; }
  .roster-group:first-child:not(:only-child) ul { grid-template-columns: 1fr; }
  .roster-group li { padding: 12px 0; border-top: 1px solid var(--line); font-size: .88rem; overflow-wrap: anywhere; }
  .roster-staff { margin-top: 24px; padding: 24px; border-left: 3px solid var(--ui-gold); border-radius: 0 10px 10px 0; background: var(--ui-bg); }
  .roster-staff ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; }
  .roster-staff li { display: grid; gap: 6px; }
  .roster-staff span { color: var(--muted); font-size: .72rem; }
  .roster-staff strong { color: var(--ui-navy); font-size: .9rem; }
  @media (max-width: 1000px) { .roster-group ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .roster-groups { grid-template-columns: 1fr; gap: 16px; } .roster-group, .roster-staff { padding: 20px; } .roster-group ul { grid-template-columns: 1fr; } .roster-staff ul { grid-template-columns: 1fr; gap: 16px; } }
</style>
