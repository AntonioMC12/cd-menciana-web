---
import { publicPhoto, type PublicAlbum } from '../lib/build-content';
import '../styles/gallery.css';
const { album } = Astro.props as { album: PublicAlbum };
const photos = album.photos || [];
---
<div data-photo-gallery data-title={album.title}>
  <div class="gallery-summary"><div><p class="eyebrow">EL CLUB, EN IMÁGENES</p><p>{photos.length} {photos.length === 1 ? 'fotografía' : 'fotografías'}{album.publishedAt && <> · <time datetime={album.publishedAt}>{new Date(`${album.publishedAt}T12:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</time></>}</p></div><span>Abre una foto para explorar el álbum</span></div>
  {photos.length ? <div class="photo-grid">{photos.map((photo, index) => <button type="button" class="photo-tile" data-photo data-src={publicPhoto(photo.id)} data-download={publicPhoto(photo.id, 'download')} data-width={photo.width} data-height={photo.height} aria-label={`Ver fotografía ${index + 1}${photo.alt ? `: ${photo.alt}` : ''}`}><img src={publicPhoto(photo.id, 'thumb')} alt={photo.alt || ''} width={photo.width} height={photo.height} loading="lazy" decoding="async" /><span class="photo-tile__fallback" hidden>Imagen no disponible</span><span class="photo-tile__number" aria-hidden="true">{String(index + 1).padStart(2, '0')} <span>↗</span></span></button>)}</div> : <div class="empty-panel"><span class="empty-panel__icon" aria-hidden="true">▧</span><h2>Un álbum por llenar.</h2><p>Aún no hay fotografías publicadas en esta galería.</p></div>}
  <dialog class="photo-viewer" aria-labelledby="viewer-title" aria-describedby="viewer-help">
    <header class="photo-viewer__header"><div><span class="eyebrow">CD MENCIANA / GALERÍA</span><h2 id="viewer-title">{album.title}</h2></div><button type="button" data-action="close" aria-label="Cerrar visualizador" autofocus>✕</button></header>
    <div class="photo-viewer__stage"><img data-viewer-image alt="" draggable="false" hidden /><p data-load-status role="status"></p></div>
    <footer class="photo-viewer__footer"><div class="photo-viewer__navigation"><button type="button" data-action="prev" aria-label="Fotografía anterior">←</button><span data-counter aria-live="polite" aria-atomic="true"></span><button type="button" data-action="next" aria-label="Fotografía siguiente">→</button></div><p data-caption></p><div class="photo-viewer__tools"><button type="button" data-action="out" aria-label="Reducir imagen">−</button><button type="button" data-action="reset" aria-label="Restablecer ajuste">Ajustar</button><button type="button" data-action="in" aria-label="Ampliar imagen">+</button><button type="button" data-action="download" aria-label="Descargar fotografía">↓ <span>Descargar</span></button></div><p id="viewer-help">Flechas para navegar · Escape para cerrar · Doble toque para ampliar</p><p data-download-status role="status"></p></footer>
  </dialog>
</div>
<script>import '../scripts/gallery';</script>
