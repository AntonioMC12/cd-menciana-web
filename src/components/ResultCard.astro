---
import type { Match } from '../data/types';
interface Props { match: Match }
const { match } = Astro.props;
const date = match.date ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeZone: 'Europe/Madrid' }).format(new Date(match.date)) : undefined;
---
<article class="result-card">
  <div><span class="result-card__label">{match.round || match.competition}{date ? ` · ${date}` : ''}</span><h3>{match.homeTeam} <span>—</span> {match.awayTeam}</h3></div>
  <div class="result-card__score" aria-label={`Resultado ${match.homeScore} a ${match.awayScore}`}>{match.homeScore} <span>:</span> {match.awayScore}</div>
</article>
