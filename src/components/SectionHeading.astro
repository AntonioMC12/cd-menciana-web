---
import { sitePath } from '../lib/paths';
interface Props { eyebrow: string; title: string; intro?: string; href?: string; linkLabel?: string; inverse?: boolean }
const { eyebrow, title, intro, href, linkLabel = 'Ver más', inverse = false } = Astro.props;
---
<div class:list={['section-heading', { 'section-heading--inverse': inverse }]}>
  <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2>{intro && <p class="section-heading__intro">{intro}</p>}</div>
  {href && <a class="text-link" href={sitePath(href)}>{linkLabel}<span aria-hidden="true">↗</span></a>}
</div>
