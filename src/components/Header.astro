---
import { sitePath } from '../lib/paths';
import BrandMark from './BrandMark.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/club/', label: 'El club' },
  { href: '/equipos/', label: 'Equipos' },
  { href: '/calendario/', label: 'Calendario' },
  { href: '/noticias/', label: 'Noticias' },
  { href: '/galerias/', label: 'Galerías' },
  { href: '/patrocinadores/', label: 'Colaboradores' },
  { href: '/tienda/', label: 'Tienda' },
  { href: '/contacto/', label: 'Contacto' },
];
---
<header class="site-header">
  <div class="site-header__bar"><div class="container">DOÑA MENCÍA <span>·</span> FÚTBOL SALA <span>·</span> TEMPORADA 2026/27</div></div>
  <div class="site-header__main container">
    <BrandMark />
    <nav class="main-nav" aria-label="Navegación principal">
      {links.map((link) => <a href={sitePath(link.href)} aria-current={path === sitePath(link.href) || (link.href !== '/' && path.startsWith(sitePath(link.href))) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Abrir menú de navegación"><span></span><span></span><span></span><b>Menú</b></summary>
      <nav aria-label="Navegación móvil">
        {links.map((link) => <a href={sitePath(link.href)} aria-current={path === sitePath(link.href) || (link.href !== '/' && path.startsWith(sitePath(link.href))) ? 'page' : undefined}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
