---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicPost, getPublicPosts, publicPhoto, type PublicPost } from '../../lib/build-content';
import { absolutePage, breadcrumbData, organizationData } from '../../lib/seo';
import { sitePath } from '../../lib/paths';
import NewsCard from '../../components/NewsCard.astro';
import ContentHeader from '../../components/ContentHeader.astro';
import { newsDate, newsArticle, relatedNews } from '../../lib/news';
import '../../styles/news.css';

export const getStaticPaths = (async () => {
  const posts = await getPublicPosts();
  return Promise.all(posts.map(async ({ slug }) => ({ params: { slug }, props: { post: await getPublicPost(slug) } })));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: PublicPost };
const path = `/noticias/${post.slug}/`;
const image = post.coverPhotoId ? publicPhoto(post.coverPhotoId) : undefined;
const published = newsDate(post.publishedAt);
const related = relatedNews(await getPublicPosts(), post);
const shareUrl = absolutePage(path);
const articleData = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  ...(post.excerpt ? { description: post.excerpt } : {}),
  mainEntityOfPage: absolutePage(path),
  ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
  ...(image ? { image } : {}),
  publisher: { '@id': organizationData['@id'] },
};
---
<BaseLayout title={post.title} description={post.excerpt || undefined} image={image} ogType="article" publishedAt={post.publishedAt} structuredData={[organizationData, breadcrumbData([{ name: 'Inicio', path: '/' }, { name: 'Noticias', path: '/noticias/' }, { name: post.title, path }]), articleData]}>
  <ContentHeader title={post.title} description={post.excerpt}>
    <nav slot="breadcrumbs" class="breadcrumbs" aria-label="Ruta de navegación"><a href={sitePath('/')}>Inicio</a><span aria-hidden="true">/</span><a href={sitePath('/noticias/')}>Noticias</a><span aria-hidden="true">/</span><span aria-current="page">{post.title}</span></nav>
    <div slot="meta" class="news-meta">{post.category && <span>{post.category}</span>}{published && <time datetime={post.publishedAt}>{published}</time>}</div>
  </ContentHeader>
  <article class="container news-story">
    {image && <div class="news-story__photo"><img src={image} alt="" width="1600" height="1100" fetchpriority="high" decoding="async" /></div>}
    <div class="news-story__reading">
      <div class="news-story__body">{post.body.map(paragraph => <p>{paragraph}</p>)}</div>
      <footer class="news-story__footer"><p>Comparte esta noticia</p><div class="news-share">
        <a href={`https://wa.me/?text=${encodeURIComponent(`${post.title} ${shareUrl}`)}`} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
        <a href={`mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent(shareUrl)}`}>Correo</a>
        <button type="button" data-copy-news hidden>Copiar enlace</button>
      </div><p class="news-share__status" data-share-status role="status" aria-live="polite"></p>
      <a class="text-link" href={sitePath('/noticias/')}>← Volver a noticias</a></footer>
    </div>
  </article>
  {related.length > 0 && <section class="news-related"><div class="container"><div class="news-section-heading"><h2>Sigue la actualidad</h2><a class="text-link" href={sitePath('/noticias/')}>Todas las noticias →</a></div><div class="news-grid news-grid--editorial">{related.map(item => <NewsCard article={newsArticle(item)} editorial />)}</div></div></section>}
</BaseLayout>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-news]');
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  if (button && navigator.clipboard && window.isSecureContext) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        const url = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href || location.href;
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = 'Enlace copiado.';
      } catch {
        if (status) status.textContent = 'No se pudo copiar. Puedes compartir mediante WhatsApp o correo.';
      }
    });
  }
</script>
