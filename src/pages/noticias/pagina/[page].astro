---
import type { GetStaticPaths } from 'astro';
import NewsIndex from '../../../components/NewsIndex.astro';
import { getPublicPosts, type PublicPost } from '../../../lib/build-content';
import { NEWS_PAGE_SIZE } from '../../../lib/news';
export const getStaticPaths = (async () => {
  const posts = await getPublicPosts();
  return Array.from({ length: Math.max(0, Math.ceil(posts.length / NEWS_PAGE_SIZE) - 1) }, (_, index) => ({ params: { page: String(index + 2) }, props: { posts, page: index + 2 } }));
}) satisfies GetStaticPaths;
const { posts, page } = Astro.props as { posts: PublicPost[]; page: number };
---
<NewsIndex posts={posts} page={page} />
