---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { newsPage, exampleArticles } from '../../lib/public-content';
export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const { items: articles, more } = await newsPage(page);
---
<BaseLayout title="Noticias" description="Actualidad, comunicados y noticias del CD Menciana.">
  <section class="page-hero"><div class="container"><p class="eyebrow">ACTUALIDAD / CD MENCIANA</p><h1>Lo que pasa<br /><em>dentro y fuera de pista.</em></h1><p>Un lugar para las novedades, las crónicas y las historias del club.</p></div></section>
  <section class="section"><div class="container">{articles.length ? <div class="news-grid">{articles.map((article, index) => <NewsCard article={article} index={index} />)}</div> : <div class="empty-panel"><h2>Aún no hay noticias publicadas</h2><p>El club publicará aquí su actualidad.</p></div>}<nav class="pager" aria-label="Páginas de noticias">{page > 1 && <a href={`/noticias/?page=${page - 1}`}>← Anteriores</a>}{more && <a href={`/noticias/?page=${page + 1}`}>Siguientes →</a>}</nav>{page === 1 && <section class="examples"><div class="notice-banner"><strong>Contenido de muestra</strong><p>Estos artículos solo muestran el formato editorial. No son noticias reales.</p></div><div class="news-grid">{exampleArticles.map((article, index) => <NewsCard article={article} index={index} />)}</div></section>}</div></section>
</BaseLayout>
