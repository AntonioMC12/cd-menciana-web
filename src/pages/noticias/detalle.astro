---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
---
<BaseLayout title="Abrir noticia" description="Acceso a una noticia publicada por el CD Menciana." noindex><div class="section container"><p>Esta dirección de noticia ha cambiado. <a class="text-link" href={sitePath('/noticias/')}>Ver todas las noticias →</a></p></div></BaseLayout>
<script>
  const slug = new URLSearchParams(location.search).get('slug');
  if (slug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) location.replace(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/noticias/${slug}/`);
</script>
