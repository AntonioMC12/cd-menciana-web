---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentHeader from '../components/ContentHeader.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Crest from '../components/Crest.astro';
import '../styles/tv.css';
const api = (import.meta.env.PUBLIC_CMS_API_URL || '').replace(/\/$/, '');
---
<BaseLayout title="CDM TV" description="Vídeos y retransmisiones del CD Menciana. Sigue el fútbol sala de Doña Mencía en el canal de YouTube del club.">
  <div class="tv-page" data-tv data-api={api}>
    <ContentHeader title="CDM" accent="TV" eyebrow="El club, en pantalla" description="Vive cada jugada. Los vídeos y las retransmisiones del CD Menciana, en un mismo lugar." index />
    <section class="container tv-feature" aria-labelledby="tv-feature-heading">
      <div class="tv-screen" data-feature-screen><div class="tv-placeholder"><Crest /><span>CDM TV</span><p>El fútbol sala de casa, más cerca.</p></div></div>
      <div class="tv-feature-copy"><p class="eyebrow">En primera fila</p><h2 id="tv-feature-heading" data-feature-title>Tu ventana al CD Menciana</h2><p data-feature-description>Vídeos y partidos del club, desde la pista hasta tu pantalla.</p><p data-status role="status" aria-live="polite">Conectando con CDM TV…</p><button type="button" class="button button--blue" data-retry hidden>Volver a intentar</button><a class="button button--blue tv-channel-link" data-channel hidden target="_blank" rel="noopener noreferrer">Ver canal en YouTube <ArrowIcon /></a></div>
    </section>
    <section class="container tv-broadcasts" aria-labelledby="tv-broadcast-heading" data-broadcasts hidden><p class="eyebrow">Sigue al equipo</p><h2 id="tv-broadcast-heading">En directo y próximamente</h2><p class="data-note" data-discovery>Consulta YouTube para comprobar la emisión actual.</p><div class="tv-grid" data-broadcast-videos></div></section>
    <section class="tv-library" aria-labelledby="tv-library-heading"><div class="container"><div class="tv-library-heading"><div><p class="eyebrow">Dentro y fuera de la pista</p><h2 id="tv-library-heading">Más del canal</h2></div><p class="tv-result-count" data-video-count role="status" aria-live="polite"></p></div><div class="tv-filters" role="group" aria-label="Filtrar vídeos" data-filters hidden>{[{ value: 'all', label: 'Todos' }, { value: 'video', label: 'Vídeos' }, { value: 'completed', label: 'Retransmisiones' }].map(filter => <button type="button" data-filter={filter.value} aria-pressed={filter.value === 'all' ? 'true' : 'false'}>{filter.label}</button>)}</div><p data-videos-empty>Los próximos contenidos del canal aparecerán aquí.</p><div class="tv-grid" data-videos></div></div></section>
    <noscript><p class="container">Activa JavaScript para consultar los vídeos y cargar el reproductor de YouTube.</p></noscript>
    <dialog class="tv-dialog" aria-labelledby="tv-player-title" data-player><div class="tv-dialog-heading"><h2 id="tv-player-title">Vídeo del club</h2><button type="button" data-close autofocus aria-label="Cerrar reproductor">Cerrar ×</button></div><div class="tv-player-frame" data-player-frame></div><div data-consent class="tv-consent"><p>Al cargar el reproductor conectarás con YouTube, que podrá tratar datos de navegación. Tu elección se aplica solo a este vídeo.</p><button type="button" class="button button--blue" data-load>Aceptar y cargar vídeo</button></div><p>Si el vídeo no se reproduce aquí, ábrelo en YouTube.</p><a class="text-link" data-player-youtube target="_blank" rel="noopener noreferrer">Ver en YouTube <ArrowIcon /></a></dialog>
  </div>
</BaseLayout>
<script>import '../scripts/tv';</script>
