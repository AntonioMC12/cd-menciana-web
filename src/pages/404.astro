---
import ArrowIcon from '../components/ArrowIcon.astro';
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentHeader from '../components/ContentHeader.astro';
---
<BaseLayout title="Página no encontrada" description="La página solicitada no existe." noindex>
  <ContentHeader title="Esta página no está" accent="en la pista." eyebrow="404 / FUERA DE JUEGO" description="Puede que la dirección haya cambiado o que el contenido aún no esté disponible." index />
  <section class="section"><div class="container"><a class="button button--blue" href={sitePath('/')}>Volver al inicio <ArrowIcon /></a></div></section>
</BaseLayout>
