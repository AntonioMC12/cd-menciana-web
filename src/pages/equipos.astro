---
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentHeader from '../components/ContentHeader.astro';
import MatchCard from '../components/MatchCard.astro';
import PlayerCard from '../components/PlayerCard.astro';
import TeamRoster from '../components/TeamRoster.astro';
import { teamRosters } from '../data/team-rosters';
import ResultCard from '../components/ResultCard.astro';
import StandingsTable from '../components/StandingsTable.astro';
import { firstTeamSource } from '../data/first-team';
import { getTeamCompetition, rfafWidgetUrl } from '../data/team-competitions';
import { players, recentResults, teams, upcomingMatches } from '../data/site';
import { sitePath } from '../lib/paths';

---

<BaseLayout title="Equipos y plantilla" description="Los equipos del CD Menciana, sus partidos, resultados y clasificaciones de la temporada 2026/27.">
  <ContentHeader title="El equipo" accent="hace el club." eyebrow="EL CLUB / EQUIPOS" description="Elige una categoría para conocerla y seguir su temporada." index />

  <section class="section"><div class="container">
    <nav class="team-selector" aria-label="Seleccionar equipo">
      {teams.map((team) => <a href={`#${team.id}`} data-team-link={team.id}>{team.name}</a>)}
    </nav>

    {teams.map((team) => {
      const competition = getTeamCompetition(team.id);
      const teamPlayers = players
        .filter((player) => player.teamId === team.id)
        .sort((a, b) => Number(b.position === 'Portero') - Number(a.position === 'Portero') || (a.number ?? Infinity) - (b.number ?? Infinity));
      return <section class="team-section team-panel" id={team.id} data-team-panel={team.id}>
        <div class="team-section__heading"><div><p class="eyebrow">TEMPORADA {team.season}</p><h2>{team.name}</h2>{team.description && <p>{team.description}</p>}</div>{competition && <span class="pill">{team.category}</span>}</div>

        {competition && <div data-team-sports={team.id}>
          <div class="team-competition__grid team-competition__preview">
            <div class="team-competition__block"><h3>Próximos partidos</h3><div class="match-list" data-team-upcoming>{team.id === 'primer-equipo' ? upcomingMatches.slice(0, 2).map((match) => <MatchCard match={match} />) : <p class="empty-panel">Cargando partidos…</p>}</div><div class="team-competition__actions"><button type="button" class="button team-competition__more" data-team-more="upcoming" aria-haspopup="dialog" aria-controls={`team-matches-${team.id}`}>Ver más partidos <ArrowIcon /></button></div></div>
            <div class="team-competition__block"><h3>Resultados</h3><div data-team-results>{team.id === 'primer-equipo' ? <div class="results-list">{recentResults.slice(0, 4).map((match) => <ResultCard match={match} />)}</div> : <p class="empty-panel">Cargando resultados…</p>}</div><div class="team-competition__actions"><button type="button" class="button team-competition__more" data-team-more="results" aria-haspopup="dialog" aria-controls={`team-matches-${team.id}`}>Ver más resultados <ArrowIcon /></button></div></div>
          </div>
          <dialog class="team-matches-dialog" id={`team-matches-${team.id}`} data-team-dialog aria-labelledby={`team-matches-title-${team.id}`}>
            <div class="team-matches-dialog__head"><div><p class="eyebrow">TEMPORADA {team.season}</p><h2 id={`team-matches-title-${team.id}`} data-team-dialog-title>Partidos y resultados</h2><p class="team-matches-dialog__team">{team.name}</p></div><button type="button" class="team-matches-dialog__close" data-team-dialog-close aria-label="Cerrar detalle" autofocus>Cerrar <span aria-hidden="true">×</span></button></div>
            <div class="team-matches-dialog__body"><div class="team-competition__grid">
              <div class="team-competition__block" data-team-dialog-section="upcoming"><div class="match-list" data-team-all-upcoming>{team.id === 'primer-equipo' ? upcomingMatches.map((match) => <MatchCard match={match} />) : <p class="empty-panel">Cargando partidos…</p>}</div></div>
              <div class="team-competition__block" data-team-dialog-section="results" hidden><div data-team-all-results>{team.id === 'primer-equipo' ? <div class="results-list">{recentResults.map((match) => <ResultCard match={match} />)}</div> : <p class="empty-panel">Cargando resultados…</p>}</div></div>
            </div></div>
            <div class="team-matches-dialog__footer"><a class="text-link" href={rfafWidgetUrl(competition, 'results')} target="_blank" rel="noopener noreferrer">Consultar en la RFAF <ArrowIcon /></a></div>
          </dialog>
          <div class="team-competition__standings"><h3>Clasificación</h3>{team.id === 'primer-equipo' ? <StandingsTable /> : <div class="standings-scroll" role="region" aria-label={`Clasificación de ${team.name}`} tabindex="0"><table class="standings-table"><caption>{team.category} · Temporada 2026/27</caption><thead><tr><th scope="col">#</th><th scope="col">Equipo</th><th scope="col">Pts</th><th scope="col">PJ</th><th scope="col">G</th><th scope="col">E</th><th scope="col">P</th><th scope="col">GF</th><th scope="col">GC</th></tr></thead><tbody data-team-standings><tr><td colspan="9">Cargando clasificación…</td></tr></tbody></table></div>}</div>
          <p class="sports-source">Datos de la RFAF · <span data-team-updated>{team.id === 'primer-equipo' ? `copia del ${firstTeamSource.checkedOn}` : 'cargando…'}</span>. <a href={rfafWidgetUrl(competition, 'results')}>Resultados oficiales <ArrowIcon /></a> · <a href={rfafWidgetUrl(competition, 'classification')}>Clasificación oficial <ArrowIcon /></a></p>
        </div>}

        {team.id === 'primer-equipo' && <div class="team-roster"><h3>Plantilla</h3><div class="player-grid">{teamPlayers.map((player) => <PlayerCard player={player} />)}</div></div>}
        {teamRosters[team.id] && <TeamRoster roster={teamRosters[team.id]} />}
      </section>;
    })}
  </div></section>

  <section class="section section--tint"><div class="container feature-strip"><div><p class="eyebrow">SIGUE LA TEMPORADA</p><h2>Cada jornada cuenta.</h2><p>Consulta el calendario completo y la clasificación del primer equipo en 3.ª División F.S., grupo 17.</p></div><a class="button button--blue" href={sitePath('/calendario/#clasificacion')}>Ver calendario <ArrowIcon /></a></div></section>
</BaseLayout>
<script>import '../scripts/team-selector.ts'; import '../scripts/team-sports.ts';</script>
