---
import ArrowIcon from '../components/ArrowIcon.astro';
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlayerCard from '../components/PlayerCard.astro';
import { players, teams } from '../data/site';
---
<BaseLayout title="Equipos y plantilla" description="Equipos y plantilla del CD Menciana. Datos oficiales en preparación.">
  <section class="page-hero"><div class="container"><p class="eyebrow">EL CLUB / EQUIPOS</p><h1>El equipo<br /><em>hace el club.</em></h1><p>Conoce nuestras categorías y a quienes defienden el azul en la pista.</p></div></section>
  <section class="section"><div class="container">{teams.map((team) => <section class="team-section"><div class="team-section__heading"><div><p class="eyebrow">TEMPORADA {team.season}</p><h2>{team.name}</h2><p>{team.description}</p></div><span class="pill">{team.category}</span></div>{players.filter((player) => player.teamId === team.id).length ? <div class="player-grid">{players.filter((player) => player.teamId === team.id).map((player) => <PlayerCard player={player} />)}</div> : <div class="empty-panel"><div class="empty-panel__icon" aria-hidden="true">#</div><h3>Plantilla pendiente de confirmar</h3><p>Los nombres, dorsales, posiciones y fotografías se publicarán con información facilitada por el club.</p></div>}</section>)}</div></section>
  <section class="section section--tint"><div class="container feature-strip"><div><p class="eyebrow">SIGUE LA TEMPORADA</p><h2>Cada jornada cuenta.</h2><p>Consulta los partidos y la clasificación del primer equipo en 3.ª División F.S., grupo 17.</p></div><a class="button button--blue" href={sitePath('/calendario/#clasificacion')}>Ver clasificación <ArrowIcon /></a></div></section>
</BaseLayout>
