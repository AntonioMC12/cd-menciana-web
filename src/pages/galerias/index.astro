---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicAlbum, getPublicAlbums, publicPhoto } from '../../lib/build-content';
import ContentHeader from '../../components/ContentHeader.astro';
import Crest from '../../components/Crest.astro';
import { sitePath } from '../../lib/paths';
import '../../styles/gallery.css';
const albums = await Promise.all((await getPublicAlbums()).map(async album => ({ ...album, displayCoverId: album.coverPhotoId || (await getPublicAlbum(album.slug)).photos?.[0]?.id })));
---
<BaseLayout title="Galerías de fútbol sala del CD Menciana" description="Fotografías y álbumes de partidos y actividades publicados por el CD Menciana en Doña Mencía.">
  <ContentHeader title="Galerías" accent="del club." eyebrow="IMÁGENES / CD MENCIANA" description="En la pista y fuera de ella. Momentos de nuestra comunidad." index />
  <section class="section gallery-section"><div class="container">
    <div class="gallery-summary"><div><p class="eyebrow">NUESTRO ARCHIVO FOTOGRÁFICO</p><p>{albums.length} {albums.length === 1 ? 'álbum publicado' : 'álbumes publicados'}</p></div><span>Elige un álbum y revive cada momento</span></div>
    {albums.length ? <div class:list={['album-grid', { 'album-grid--single': albums.length === 1 }]}>{albums.map(album => <article class="album-card"><a class="album-card__cover" href={sitePath(`/galerias/${album.slug}/`)} aria-label={`Ver galería: ${album.title}`}><div class="album-card__placeholder"><Crest /><span class="album-card__mark">CD MENCIANA / IMÁGENES</span></div>{album.displayCoverId && <img src={publicPhoto(album.displayCoverId, albums.length === 1 ? 'web' : 'thumb')} alt="" width="480" height="360" loading={albums.length === 1 ? 'eager' : 'lazy'} decoding="async" />}</a><div class="album-card__body">{album.publishedAt && <time datetime={album.publishedAt}>{new Date(`${album.publishedAt}T12:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</time>}<h2><a href={sitePath(`/galerias/${album.slug}/`)}>{album.title}</a></h2>{album.description && <p>{album.description}</p>}<a class="text-link" href={sitePath(`/galerias/${album.slug}/`)}>Explorar álbum →</a></div></article>)}</div> : <div class="empty-panel"><span class="empty-panel__icon" aria-hidden="true">▧</span><h2 style="font-size:1.5rem">Los próximos momentos, aquí.</h2><p>Aún no hay galerías publicadas.</p></div>}
  </div></section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLImageElement>('.album-card__cover img').forEach(image => {
    const fail = () => { image.hidden = true; };
    image.addEventListener('error', fail);
    if (image.complete && !image.naturalWidth) fail();
  });
</script>
