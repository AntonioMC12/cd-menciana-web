---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
---
<BaseLayout title="Abrir galería" description="Acceso a una galería publicada por el CD Menciana." noindex><div class="section container"><p>Esta dirección de galería ha cambiado. <a class="text-link" href={sitePath('/galerias/')}>Ver todas las galerías →</a></p></div></BaseLayout>
<script>
  const slug = new URLSearchParams(location.search).get('slug');
  if (slug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) location.replace(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/galerias/${slug}/`);
</script>
