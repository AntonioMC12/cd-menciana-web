---
import ArrowIcon from '../components/ArrowIcon.astro';
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Crest from '../components/Crest.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MatchCard from '../components/MatchCard.astro';
import ResultCard from '../components/ResultCard.astro';
import SponsorCard from '../components/SponsorCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { getPublicPosts, publicPhoto } from '../lib/build-content';
import { organizationData } from '../lib/seo';
import { institutionalPartners, principalSponsors, recentResults, upcomingMatches, site } from '../data/site';
const publishedPosts = (await getPublicPosts()).slice(0, 3);
---
<BaseLayout title="Club de fútbol sala en Doña Mencía" description="CD Menciana Apaga y Vámonos F.S.: equipos, calendario, resultados y noticias del club de fútbol sala de Doña Mencía, Córdoba." structuredData={organizationData}>
  <section class="hero">
    <picture class="hero__photo">
      <source type="image/webp" srcset={`${sitePath('/images/plantilla-hero-900.webp')} 900w, ${sitePath('/images/plantilla-hero-1800.webp')} 1800w`} sizes="(max-width: 760px) 100vw, 64vw" />
      <img src={sitePath('/images/plantilla-hero-1800.jpg')} alt="Plantilla del CD Menciana posando en el pabellón" width="1800" height="1200" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero__texture" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy"><p class="eyebrow eyebrow--gold">Club Deportivo · Doña Mencía</p><h1>Más que<br /><em>fútbol sala.</em></h1><p>El CD Menciana Apaga y Vámonos F.S. reúne a Doña Mencía en torno al fútbol sala. Consulta nuestros equipos, próximos partidos, resultados y noticias.</p><div class="hero__actions"><a class="button button--gold" href={`${sitePath('/calendario/')}#proximo-partido`}>Próximo partido <ArrowIcon /></a><a class="button button--outline-light" href={sitePath('/club/')}>Conoce el club</a></div></div>
      <div class="hero__art"><Crest class="hero__badge" alt="Escudo del Club Deportivo Menciana" loading="eager" /></div>
    </div>
    <div class="hero__footer container"><span>Temporada {site.season}</span><span>Identidad · Competición · Comunidad</span></div>
  </section>

  <section class="section match-section"><div class="container"><SectionHeading eyebrow="01 / COMPETICIÓN" title="La próxima cita" intro="El siguiente partido publicado por la RFAF para nuestro primer equipo." href={sitePath('/calendario/')} linkLabel="Ver calendario" /><div data-sports-home-next><MatchCard match={upcomingMatches[0]} prominent /></div></div></section>

  <section class="section section--tint"><div class="container"><SectionHeading eyebrow="02 / MARCADORES" title="Últimos resultados" intro="Marcadores del primer equipo publicados por la RFAF." href={sitePath('/calendario/')} linkLabel="Todos los partidos" /><div data-sports-home-results>{recentResults.length ? <div class="results-list">{recentResults.slice(0, 3).map((match) => <ResultCard match={match} />)}</div> : <div class="empty-panel empty-panel--horizontal"><div class="empty-panel__icon" aria-hidden="true">0 : 0</div><div><h3>Aún no hay resultados publicados</h3><p>Este espacio se actualizará cuando la RFAF publique sus marcadores.</p></div><a class="text-link" href={sitePath('/calendario/')}>Ir al calendario <ArrowIcon /></a></div>}</div></div></section>

  <section class="section"><div class="container"><SectionHeading eyebrow="03 / ACTUALIDAD" title="Noticias del club" intro="Comunicados, jornadas e historias de nuestra comunidad." href={sitePath('/noticias/')} linkLabel="Todas las noticias" />{publishedPosts.length ? <div class="news-grid">{publishedPosts.map((post, index) => <NewsCard article={{ slug: post.slug, title: post.title, excerpt: post.excerpt, body: post.body, category: post.category, image: post.coverPhotoId ? publicPhoto(post.coverPhotoId, 'thumb') : undefined, publishedAt: post.publishedAt, status: 'confirmed' }} index={index} />)}</div> : <div class="empty-panel">Aún no hay noticias publicadas.</div>}</div></section>

  <section class="club-banner"><div class="container club-banner__inner"><div><p class="eyebrow eyebrow--gold">NUESTRA IDENTIDAD</p><h2>Un club. Un pueblo.<br /><em>Una forma de sentirlo.</em></h2><p>El fútbol sala nos reúne en Doña Mencía. Descubre la identidad y el espíritu que recoge nuestro manual de marca.</p><a class="button button--outline-light" href={sitePath('/club/')}>Descubre el club <ArrowIcon /></a></div><Crest class="club-banner__graphic" /></div></section>

  <section class="section sponsor-section">
    <div class="container">
      <SectionHeading eyebrow="04 / PATROCINIO" title="Impulsan al Menciana" intro="Nuestros patrocinadores principales hacen posible seguir creciendo juntos." href={sitePath('/patrocinadores/')} linkLabel="Todos los colaboradores" />
      <div class="sponsor-grid sponsor-grid--featured">{principalSponsors.map((sponsor) => <SponsorCard sponsor={sponsor} />)}</div>
      <div class="sponsor-group"><h3>Colaboración institucional</h3><p>Entidades públicas que acompañan al CD Menciana.</p><div class="sponsor-grid">{institutionalPartners.map((sponsor) => <SponsorCard sponsor={sponsor} />)}</div></div>
    </div>
  </section>
</BaseLayout>
<script>import '../scripts/public-sports.ts';</script>
