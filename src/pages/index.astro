---
import ArrowIcon from '../components/ArrowIcon.astro';
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Crest from '../components/Crest.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MatchCard from '../components/MatchCard.astro';
import ResultCard from '../components/ResultCard.astro';
import NewsCard from '../components/NewsCard.astro';
import SponsorCard from '../components/SponsorCard.astro';
import { articles, recentResults, upcomingMatches, site, sponsors } from '../data/site';
---
<BaseLayout>
  <section class="hero">
    <picture class="hero__photo">
      <source type="image/webp" srcset={`${sitePath('/images/plantilla-hero-900.webp')} 900w, ${sitePath('/images/plantilla-hero-1800.webp')} 1800w`} sizes="(max-width: 760px) 100vw, 64vw" />
      <img src={sitePath('/images/plantilla-hero-1800.jpg')} alt="Plantilla del CD Menciana posando en el pabellón" width="1800" height="1200" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero__texture" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy"><p class="eyebrow eyebrow--gold">Club Deportivo · Doña Mencía</p><h1>Más que<br /><em>fútbol sala.</em></h1><p>La casa digital del CD Menciana. Vive el club, sigue la competición y mantente cerca de todo lo que nos mueve.</p><div class="hero__actions"><a class="button button--gold" href={sitePath('/calendario/')}>Próximo partido <ArrowIcon /></a><a class="button button--outline-light" href={sitePath('/club/')}>Conoce el club</a></div></div>
      <div class="hero__art"><Crest class="hero__badge" alt="Escudo del Club Deportivo Menciana" loading="eager" /></div>
    </div>
    <div class="hero__footer container"><span>Temporada {site.season}</span><span>Identidad · Competición · Comunidad</span></div>
  </section>

  <section class="section match-section"><div class="container"><SectionHeading eyebrow="01 / COMPETICIÓN" title="La próxima cita" intro="Toda la información del siguiente encuentro, en cuanto esté confirmada." href={sitePath('/calendario/')} linkLabel="Ver calendario" /><MatchCard match={upcomingMatches[0]} prominent /></div></section>

  <section class="section section--tint"><div class="container"><SectionHeading eyebrow="02 / MARCADORES" title="Últimos resultados" intro="Los resultados oficiales aparecerán aquí al finalizar cada encuentro." href={sitePath('/calendario/')} linkLabel="Todos los partidos" />{recentResults.length ? <div class="results-list">{recentResults.slice(0, 3).map((match) => <ResultCard match={match} />)}</div> : <div class="empty-panel empty-panel--horizontal"><div class="empty-panel__icon" aria-hidden="true">0 : 0</div><div><h3>Aún no hay resultados publicados</h3><p>Este espacio se actualizará cuando el club confirme sus marcadores.</p></div><a class="text-link" href={sitePath('/calendario/')}>Ir al calendario <ArrowIcon /></a></div>}</div></section>

  <section class="section"><div class="container"><SectionHeading eyebrow="03 / ACTUALIDAD" title="Noticias del club" intro="Comunicados, jornadas e historias de nuestra comunidad." href={sitePath('/noticias/')} linkLabel="Todas las noticias" /><div class="news-grid">{articles.slice(0, 3).map((article, index) => <NewsCard article={article} index={index} />)}</div></div></section>

  <section class="club-banner"><div class="container club-banner__inner"><div><p class="eyebrow eyebrow--gold">NUESTRA IDENTIDAD</p><h2>Un club. Una ciudad.<br /><em>Una forma de sentirlo.</em></h2><p>El fútbol sala nos reúne en Doña Mencía. Descubre la identidad y el espíritu que recoge nuestro manual de marca.</p><a class="button button--outline-light" href={sitePath('/club/')}>Descubre el club <ArrowIcon /></a></div><Crest class="club-banner__graphic" /></div></section>

  <section class="section sponsor-section"><div class="container"><SectionHeading eyebrow="04 / COLABORACIÓN" title="Juntos hacemos club" intro="Un espacio para reconocer a las entidades que acompañan al CD Menciana." href={sitePath('/patrocinadores/')} linkLabel="Patrocinadores" />{sponsors.length ? <div class="sponsor-grid">{sponsors.map((sponsor) => <SponsorCard sponsor={sponsor} />)}</div> : <div class="sponsor-placeholder"><div class="sponsor-placeholder__identity"><Crest class="sponsor-placeholder__crest" /><span><b>+</b> COMUNIDAD</span></div><p>Relación de patrocinadores pendiente de confirmación.</p></div>}</div></section>
</BaseLayout>
