---
import ArrowIcon from '../components/ArrowIcon.astro';
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Crest from '../components/Crest.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MatchCard from '../components/MatchCard.astro';
import ResultCard from '../components/ResultCard.astro';
import SponsorCard from '../components/SponsorCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { getPublicPosts, getPublicAlbums, getPublicAlbum, publicPhoto } from '../lib/build-content';
import { organizationData } from '../lib/seo';
import { firstTeamSource } from '../data/first-team';
import { institutionalPartners, principalSponsors, recentResults, upcomingMatches, site, teams, players } from '../data/site';
import '../styles/home.css';
const [posts, albums] = await Promise.all([getPublicPosts(), getPublicAlbums()]);
const publishedPosts = posts.slice(0, 3);
const publishedAlbums = await Promise.all(albums.slice(0, 3).map(async album => ({
  ...album,
  displayCoverId: album.coverPhotoId || (await getPublicAlbum(album.slug)).photos?.[0]?.id,
})));
const featuredPlayers = ['mara', 'david', 'jesus'].map(id => players.find(player => player.id === id)!);
const heroPhotos = ['equipo', 'capitan', 'disparo', 'jugada'];
---
<BaseLayout title="Club de fútbol sala en Doña Mencía" description="CD Menciana Apaga y Vámonos F.S.: equipos, calendario, resultados y noticias del club de fútbol sala de Doña Mencía, Córdoba." structuredData={organizationData}>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title" data-home-film>
      <div class="home-hero__photo" aria-hidden="true">
        {heroPhotos.map((photo, index) => <picture class:list={['home-hero__slide', { 'home-hero__slide--active': index === 0 }]} data-hero-slide>
          <img src={sitePath(`/images/home/fallback-${photo}-1000.webp`)} srcset={[640, 1000, 1600].map(width => `${sitePath(`/images/home/fallback-${photo}-${width}.webp`)} ${width}w`).join(', ')} sizes="(max-width: 767px) 100vw, 60vw" alt="" width="1000" height={photo === 'equipo' ? 667 : 1500} fetchpriority={index === 0 ? 'high' : 'low'} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        </picture>)}
      </div>
      <video class="home-hero__film" data-film-desktop={sitePath('/videos/home/menciana-film.mp4')} data-film-mobile={sitePath('/videos/home/menciana-film-mobile.mp4')} poster={sitePath('/images/home/film-poster.webp')} autoplay muted playsinline loop preload="auto" aria-hidden="true" tabindex="-1"></video>
      <div class="container home-hero__inner">
        <div class="home-hero__copy">
          <p class="eyebrow eyebrow--gold">Doña Mencía · Apaga y Vámonos F.S.</p>
          <h1 id="home-title">Más que<br />fútbol sala.<span>"Porque todos compartimos una Pasión | #CreciendoJuntos"</span></h1>
          <p class="home-hero__lead">Un equipo en la pista.<br />Todo un pueblo detrás.</p>
          <div class="home-hero__actions"><a class="button button--gold" href="#competicion">La próxima cita <ArrowIcon /></a><a class="home-hero__link" href={sitePath('/club/')}>Conoce el club <ArrowIcon /></a></div>
        </div>
        <div class="home-hero__caption"><span>DOÑA MENCÍA</span><span>Nuestra casa · Temporada {site.season}</span><a class="home-hero__tourism" href="https://www.menciaecoturismo.es/" target="_blank" rel="noopener noreferrer" aria-label="Descubre Doña Mencía en su web de turismo (abre en nueva pestaña)">Descubre Doña Mencía <ArrowIcon /></a></div>
      </div>
      <div class="container home-hero__footer"><span>Orgullo de pertenecer.</span><a href={sitePath('/equipos/')}>Nuestros equipos <ArrowIcon /></a></div>
    </section>
    <section class="home-competition container" id="competicion" aria-labelledby="competition-title">
      <div class="home-competition__heading"><div><p class="eyebrow">01 / EN LA PISTA</p><h2 id="competition-title">Cada jornada cuenta.</h2></div><a class="text-link" href={sitePath('/calendario/')}>Calendario completo <ArrowIcon /></a></div>
      <div class="home-competition__grid">
        <div class="home-competition__next" data-sports-home-next><MatchCard match={upcomingMatches[0]} prominent /></div>
        <div class="home-competition__results"><h3>Últimos resultados</h3><div data-sports-home-results>{recentResults.length ? <div class="results-list">{recentResults.slice(0, 3).map(match => <ResultCard match={match} />)}</div> : <div class="empty-panel"><h3>La temporada está por escribir.</h3><p>Aún no hay resultados publicados.</p></div>}</div></div>
      </div>
      <p class="home-competition__source">Primer equipo · Datos RFAF · <span data-sports-updated>copia del {firstTeamSource.checkedOn}</span>. <a href={sitePath('/calendario/#clasificacion')}>Ver clasificación <ArrowIcon /></a></p>
    </section>
    <section class="home-section home-news"><div class="container" data-home-reveal>
      <SectionHeading eyebrow="02 / ACTUALIDAD" title="Lo que nos mueve." intro="Noticias, jornadas e historias del CD Menciana." href="/noticias/" linkLabel="Toda la actualidad" />
      {publishedPosts.length ? <div class:list={['home-news__grid', { 'home-news__grid--two': publishedPosts.length === 2, 'home-news__grid--single': publishedPosts.length === 1 }]}>{publishedPosts.map((post, index) => <NewsCard article={{ slug: post.slug, title: post.title, excerpt: post.excerpt, body: post.body, category: post.category, image: post.coverPhotoId ? publicPhoto(post.coverPhotoId, index === 0 ? 'web' : 'thumb') : undefined, publishedAt: post.publishedAt, status: 'confirmed' }} index={index} />)}</div> : <div class="home-news__empty"><div><h3>La actualidad empieza aquí.</h3><p>Aún no hay noticias publicadas. Mientras tanto, conoce los equipos y sigue la competición.</p></div><a class="text-link" href={sitePath('/equipos/')}>Descubre los equipos <ArrowIcon /></a></div>}
    </div></section>
    <section class="home-teams home-section" aria-labelledby="teams-title"><div class="container home-teams__grid" data-home-reveal>
      <div class="home-teams__copy"><p class="eyebrow eyebrow--gold">03 / NUESTROS EQUIPOS</p><h2 id="teams-title">La misma pasión.<br /><em>Desde la base.</em></h2><p>Del primer equipo a la escuela, un mismo escudo nos une. Conoce las categorías y a quienes lo defienden en la pista.</p><a class="button button--gold" href={sitePath('/equipos/')}>Conoce la plantilla <ArrowIcon /></a></div>
      <div class="home-teams__players">{featuredPlayers.map(player => <a class="home-player" href={sitePath('/equipos/#primer-equipo')} aria-label={`Conocer a ${player.name} y la plantilla del primer equipo`}><img src={sitePath(player.photo!)} alt={player.name} width="400" height="500" loading="lazy" decoding="async" /><div><span>{player.number}</span><h3>{player.name}</h3></div></a>)}</div>
      <nav class="home-teams__categories" aria-label="Categorías del club">{teams.map(team => <a href={sitePath(`/equipos/#${team.id}`)}>{team.id === 'primer-equipo' ? 'Primer equipo' : team.id === 'infantil' ? 'Infantil' : team.name}<ArrowIcon /></a>)}</nav>
    </div></section>
    <section class="home-story home-section" aria-labelledby="story-title"><div class="container home-story__grid" data-home-reveal>
      <figure class="home-story__moment"><img class="home-story__photo" src={sitePath('/images/home/celebracion.webp')} alt="Dos jugadores del CD Menciana celebran juntos en la pista" width="800" height="1200" loading="lazy" decoding="async" /><Crest class="home-story__crest" alt="Escudo del Club Deportivo Menciana Apaga y Vámonos F.S." /><figcaption>Un escudo. Una misma emoción.</figcaption></figure>
      <div><p class="eyebrow">04 / EL CLUB</p><h2 id="story-title">Dos historias.<br /><em>Un mismo latido.</em></h2><p>Apaga y Vámonos y el Club Deportivo Menciana comparten un camino por el deporte de nuestro pueblo. Una historia que continúa con cada generación, cada familia y cada jornada.</p><a class="text-link" href={sitePath('/club/')}>Descubre nuestra historia <ArrowIcon /></a></div>
    </div></section>
    {publishedAlbums.length > 0 && <section class="home-section home-gallery"><div class="container" data-home-reveal><SectionHeading eyebrow="EN IMÁGENES" title="Momentos que se quedan." href="/galerias/" linkLabel="Todas las galerías" /><div class="home-gallery__grid">{publishedAlbums.map(album => <a class="home-album" href={sitePath(`/galerias/${album.slug}/`)}>{album.displayCoverId ? <img src={publicPhoto(album.displayCoverId, 'web')} alt="" width="600" height="400" loading="lazy" decoding="async" /> : <div class="home-album__placeholder"><Crest /></div>}<div><h3>{album.title}</h3><span>Ver álbum <ArrowIcon /></span></div></a>)}</div></div></section>}
    <section class="home-atmosphere" aria-labelledby="atmosphere-title">
      <picture><source type="image/webp" srcset={`${sitePath('/images/home/aficion-900.webp')} 900w, ${sitePath('/images/home/aficion-1600.webp')} 1600w`} sizes="100vw" /><img src={sitePath('/images/home/aficion-1600.webp')} alt="La afición del CD Menciana llena la grada durante el partido frente al Santaella" width="1600" height="1067" loading="lazy" decoding="async" /></picture>
      <div class="container home-atmosphere__inner" data-home-reveal><p class="eyebrow eyebrow--gold">EL OTRO EQUIPO</p><h2 id="atmosphere-title">La pasión también<br />juega en la grada.</h2><p>Cada jugada se vive dentro y fuera de la pista.<br />El fútbol sala nos reúne.</p><a class="button button--outline-light" href={sitePath('/calendario/')}>Nos vemos en la próxima cita <ArrowIcon /></a></div>
    </section>
    <section class="home-section home-sponsors"><div class="container" data-home-reveal>
      <SectionHeading eyebrow="05 / JUNTOS LLEGAMOS MÁS LEJOS" title="También son parte del equipo." intro="El apoyo que hace posible seguir creciendo." href="/patrocinadores/" linkLabel="Todos los colaboradores" />
      <div class="sponsor-grid sponsor-grid--featured">{principalSponsors.map(sponsor => <SponsorCard sponsor={sponsor} />)}</div>
      <div class="home-sponsors__institutions"><h3>Colaboración institucional</h3><div class="sponsor-grid">{institutionalPartners.map(sponsor => <SponsorCard sponsor={sponsor} />)}</div></div>
    </div></section>
    <section class="home-contact"><div class="container"><div><p class="eyebrow eyebrow--gold">TU CLUB, CERCA</p><h2>Hay sitio para tu pasión.</h2></div><a class="button button--outline-light" href={sitePath('/contacto/')}>Contacta con el club <ArrowIcon /></a></div></section>
  </div>
</BaseLayout>
<script>import '../scripts/public-sports.ts'; import '../scripts/home.ts'; import '../scripts/home-film.ts';</script>
