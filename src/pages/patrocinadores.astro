---
import ArrowIcon from '../components/ArrowIcon.astro';
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Crest from '../components/Crest.astro';
import SponsorCard from '../components/SponsorCard.astro';
import { sponsors } from '../data/site';
---
<BaseLayout title="Colaboradores" description="Entidades públicas colaboradoras del CD Menciana.">
  <section class="page-hero"><div class="container"><p class="eyebrow">COLABORACIÓN / COMUNIDAD</p><h1>Crecer<br /><em>juntos.</em></h1><p>El apoyo a nuestro club merece un espacio claro y visible.</p></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">COLABORACIÓN INSTITUCIONAL</p><h2>Quienes nos acompañan</h2><p class="section-heading__intro">Estas entidades públicas colaboran con el CD Menciana y forman parte de nuestra comunidad.</p></div></div><div class="sponsor-grid">{sponsors.map((sponsor) => <SponsorCard sponsor={sponsor} />)}</div></div></section>
  <section class="club-banner"><div class="container club-banner__inner"><div><p class="eyebrow eyebrow--gold">COLABORAR</p><h2>Hagamos<br /><em>equipo.</em></h2><p>El canal institucional de contacto se añadirá en cuanto el club lo confirme.</p><a class="button button--outline-light" href={sitePath('/contacto/')}>Ir a contacto <ArrowIcon /></a></div><Crest class="club-banner__graphic" /></div></section>
</BaseLayout>
