---
import ArrowIcon from '../components/ArrowIcon.astro';
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Crest from '../components/Crest.astro';
import SponsorCard from '../components/SponsorCard.astro';
import { institutionalPartners, otherSponsors, principalSponsors } from '../data/site';
---
<BaseLayout title="Patrocinadores y colaboradores" description="Patrocinadores principales y entidades colaboradoras del CD Menciana.">
  <section class="page-hero"><div class="container"><p class="eyebrow">PATROCINIO / COMUNIDAD</p><h1>Crecer<br /><em>juntos.</em></h1><p>Reconocemos a quienes hacen posible el camino del CD Menciana.</p></div></section>
  <section class="section sponsor-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">PATROCINADORES PRINCIPALES</p><h2>Un apoyo fundamental</h2><p class="section-heading__intro">Capricho Andaluz y RAVI ocupan un lugar destacado en el club.</p></div></div>
      <div class="sponsor-grid sponsor-grid--featured">{principalSponsors.map((sponsor) => <SponsorCard sponsor={sponsor} />)}</div>
      <div class="sponsor-group"><h3>Más patrocinadores</h3><p>Negocios y marcas que también apoyan al club.</p><div class="sponsor-grid sponsor-grid--secondary">{otherSponsors.map((sponsor) => <SponsorCard sponsor={sponsor} />)}</div></div>
      <div class="sponsor-group"><h3>Colaboración institucional</h3><p>Entidades públicas que acompañan al CD Menciana.</p><div class="sponsor-grid">{institutionalPartners.map((sponsor) => <SponsorCard sponsor={sponsor} />)}</div></div>
    </div>
  </section>
  <section class="club-banner"><div class="container club-banner__inner"><div><p class="eyebrow eyebrow--gold">COLABORAR</p><h2>Hagamos<br /><em>equipo.</em></h2><p>Escríbenos por correo electrónico o por las redes sociales del club para hablar de colaboraciones.</p><a class="button button--outline-light" href={sitePath('/contacto/')}>Ir a contacto <ArrowIcon /></a></div><Crest class="club-banner__graphic" /></div></section>
</BaseLayout>
