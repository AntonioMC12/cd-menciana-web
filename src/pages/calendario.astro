---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentHeader from '../components/ContentHeader.astro';
import StandingsTable from '../components/StandingsTable.astro';
import { firstTeamSource } from '../data/first-team';
import { firstTeamMatches } from '../data/first-team';
import MatchCard from '../components/MatchCard.astro';
import { upcomingMatches } from '../data/site';
import { teamCompetitions, competitiveTeamIds } from '../data/team-competitions';
import '../styles/calendar.css';
const formatMatchDate = (date?: string) => date ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'long', timeZone: 'Europe/Madrid' }).format(new Date(date.includes('T') ? date : `${date}T12:00:00+02:00`)) : 'Fecha pendiente';
---
<BaseLayout title="Calendario y resultados de fútbol sala 2026/27" description="Consulta fechas, rivales, pabellones, jornadas y resultados del CD Menciana Apaga y Vámonos F.S. y sus categorías de fútbol sala.">
  <ContentHeader title="Calendario" accent="y resultados." eyebrow="TEMPORADA 2026–27 / CD MENCIANA" description="Encuentra el próximo partido de cada categoría y sigue cada jornada de un vistazo." index />

  <section class="section calendar-section" data-calendar>
    <div class="container">
      <div class="calendar-toolbar">
        <div class="calendar-category">
          <span class="calendar-toolbar__label">Categoría</span>
          <button class="calendar-category__trigger" type="button" aria-expanded="false" aria-controls="calendar-category-menu" data-category-trigger><span data-category-label>Primer equipo</span><span aria-hidden="true">⌄</span></button>
          <div class="calendar-category__backdrop" data-category-backdrop hidden></div>
          <div class="calendar-category__menu" id="calendar-category-menu" aria-label="Seleccionar categoría" data-category-menu hidden>
            <p class="calendar-category__mobile-title">Selecciona una categoría</p>
            <button type="button" data-category-option="all">Todas las categorías</button>
            {competitiveTeamIds.map((id) => <button type="button" data-category-option={id}>{teamCompetitions[id].label}<small>{teamCompetitions[id].category}</small></button>)}
          </div>
        </div>
        <div class="calendar-month-nav" aria-label="Navegar por meses">
          <button type="button" data-month-prev aria-label="Mes anterior">‹</button>
          <h2 data-month-label></h2>
          <button type="button" data-month-next aria-label="Mes siguiente">›</button>
          <button type="button" class="calendar-today" data-month-today>Hoy</button>
        </div>
        <div class="calendar-view" role="group" aria-label="Vista de partidos">
          <button type="button" data-view="grid" aria-pressed="true">Calendario</button>
          <button type="button" data-view="list" aria-pressed="false">Lista</button>
        </div>
      </div>
      <p class="calendar-notice" role="status" data-calendar-status></p>
      <div class="calendar-next" id="proximo-partido" data-calendar-next>{upcomingMatches[0] && <MatchCard match={upcomingMatches[0]} prominent />}</div>
      <div class="calendar-results-heading"><div><p class="eyebrow">CADA JORNADA CUENTA</p><h2>Los encuentros</h2></div><p data-calendar-count></p></div>
      <div class="calendar-content" data-calendar-content aria-live="polite">
        <div class="calendar-agenda" aria-label="Partidos del primer equipo publicados por la RFAF">
          {firstTeamMatches.map((match) => <article class="calendar-static-match">
            <p class="eyebrow">{match.competition} · {match.round}</p>
            <h3>{match.homeTeam} — {match.awayTeam}</h3>
            <p>{formatMatchDate(match.date)} · {match.date?.includes('T') ? new Intl.DateTimeFormat('es-ES', { timeStyle: 'short', timeZone: 'Europe/Madrid' }).format(new Date(match.date)) : 'Hora pendiente'} · {match.venue || 'Pabellón pendiente'}</p>
            <p>{match.status === 'finished' ? `Finalizado · ${match.homeScore}–${match.awayScore}` : match.status === 'postponed' ? 'Aplazado' : 'Próximo partido'}</p>
          </article>)}
        </div>
      </div>
      <p class="sports-source">Datos oficiales RFAF · <span data-calendar-updated>Primera copia verificada el {firstTeamSource.checkedOn}</span>. <a href={firstTeamSource.resultsUrl} data-calendar-source target="_blank" rel="noopener noreferrer">Consultar la competición ↗</a></p>
    </div>
  </section>

  <section class="section section--tint" id="clasificacion"><div class="container"><div class="section-heading"><div><p class="eyebrow">3.ª DIVISIÓN F.S. · GRUPO 17</p><h2>Clasificación del primer equipo</h2><p class="section-heading__intro">Tabla oficial del grupo 17. La posición puede cambiar tras cada jornada.</p></div></div><StandingsTable /><p class="sports-source"><a href={firstTeamSource.standingsUrl} target="_blank" rel="noopener noreferrer">Ver clasificación actualizada en la RFAF ↗</a></p></div></section>

  <dialog class="calendar-dialog" data-match-dialog aria-labelledby="calendar-dialog-title">
    <div class="calendar-dialog__head"><p class="eyebrow">FICHA DEL PARTIDO</p><button type="button" data-dialog-close aria-label="Cerrar detalles">×</button></div>
    <div data-dialog-content></div>
  </dialog>
</BaseLayout>
<script>import '../scripts/calendar.ts'; import '../scripts/public-sports.ts';</script>
