---
import BaseLayout from '../layouts/BaseLayout.astro';
import MatchCard from '../components/MatchCard.astro';
import ResultCard from '../components/ResultCard.astro';
import { upcomingMatches, recentResults } from '../data/site';
import { firstTeamSource } from '../data/first-team';
import StandingsTable from '../components/StandingsTable.astro';
---
<BaseLayout title="Calendario y resultados" description="Próximos partidos y resultados oficiales del CD Menciana.">
  <section class="page-hero"><div class="container"><p class="eyebrow">3.ª DIVISIÓN F.S. / GRUPO 17 / 2026–27</p><h1>La temporada,<br /><em>partido a partido.</em></h1><p>Calendario, resultados y clasificación del primer equipo.</p></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">PRÓXIMAS CITAS</p><h2>Próximos partidos</h2><p class="section-heading__intro">La RFAF ha publicado estas jornadas. Los horarios pendientes y cualquier cambio deben comprobarse en la fuente oficial.</p></div></div><div class="match-list">{upcomingMatches.length ? upcomingMatches.map((match) => <MatchCard match={match} />) : <MatchCard prominent />}</div><p class="sports-source">Datos consultados el {firstTeamSource.checkedOn}. <a href={firstTeamSource.resultsUrl}>Ver calendario y resultados actualizados en la RFAF ↗</a></p></div></section>
  <section class="section section--tint"><div class="container"><div class="section-heading"><div><p class="eyebrow">YA DISPUTADOS</p><h2>Resultados</h2></div></div>{recentResults.length ? <div class="results-list">{recentResults.map((match) => <ResultCard match={match} />)}</div> : <div class="empty-panel"><div class="empty-panel__icon" aria-hidden="true">0 : 0</div><h3>Sin resultados publicados</h3><p>Los marcadores se mostrarán cuando el club los confirme.</p></div>}</div></section>
  <section class="section" id="clasificacion"><div class="container"><div class="section-heading"><div><p class="eyebrow">LA LIGA</p><h2>Clasificación</h2><p class="section-heading__intro">Tabla oficial del grupo 17 consultada el {firstTeamSource.checkedOn}. La posición puede cambiar tras cada jornada.</p></div></div><StandingsTable /><p class="sports-source"><a href={firstTeamSource.standingsUrl}>Ver clasificación actualizada en la RFAF ↗</a></p></div></section>
</BaseLayout>
